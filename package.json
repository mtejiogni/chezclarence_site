{
  "name": "chezclarence_site",
  "version": "1.0.0",
  "private": true,
  "description": "Site vitrine de Chez Clarence (Restaurant, Snack & Grill) — (HTML/CSS/JS/PHP)",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./assets/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./assets/css/tailwind.css --watch",
    "copy:vendor": "node scripts/copy-vendor.js",
    "postinstall": "node scripts/copy-vendor.js",
    "build": "npm run copy:vendor && npm run build:css"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.13",
    "postcss": "^8.4.47",
    "autoprefixer": "^10.4.20"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.6.0",
    "jquery": "^3.7.1",
    "sweetalert2": "^11.14.1",
    "chosen-js": "^1.8.7",
    "aos": "^2.3.4",
    "swiper": "^14.0.5"
  }
}
