# ──────────────────────────────────────────────────────────────
# Copiez ce fichier en ".env" (même dossier) puis renseignez vos
# véritables identifiants. Le fichier ".env" ne doit jamais être
# versionné (voir .gitignore).
# ──────────────────────────────────────────────────────────────

# Connexion à la base de données MySQL DÉDIÉE à ce site (voir
# database/schema.sql). Cette base est indépendante de celle de
# l'application de gestion interne.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chezclarence_site
DB_USERNAME=root
DB_PASSWORD=

# Environnement : "local" affiche les erreurs PHP en détail,
# "production" les masque et les journalise seulement.
APP_ENV=local

# URL publique du site (utilisée pour les balises Open Graph, etc.)
APP_URL=https://www.chezclarence.cm

# Clé secrète utilisée pour sécuriser les sessions d'administration.
# Générez une valeur aléatoire unique en production, par exemple avec :
#   php -r "echo bin2hex(random_bytes(32));"
APP_KEY=change-moi-en-une-valeur-aleatoire-unique
